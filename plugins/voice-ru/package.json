{
  "name": "@local/dsh-speech-to-text-gigaam",
  "version": "1.0.0",
  "private": true,
  "description": "Локальное распознавание русской речи для DSH: GigaAM v3 e2e CTC с пунктуацией на sherpa-onnx, без облака и Python",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./worker": "./worker.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "worker.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/ru.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "dependencies": {
    "sherpa-onnx-node": "1.13.8"
  }
}
