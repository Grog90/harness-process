{
  "name": "@harness/dsh-guard",
  "version": "1.0.0",
  "private": true,
  "description": "Ограждение инструментов DSH решениями harness: роли, allowed_files, защищённые пути",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "guard-core.mjs",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/ru.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
