      "id": 14,
      "type": "timeseries",
      "title": "Твои запросы: зависшие соединения",
      "description": "Сколько соединений в интернет висит в попытке установиться. Локальный шум исключён.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "router_flows_stuck{service!=\"local\"}",
