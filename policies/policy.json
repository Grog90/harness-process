{
  "version": "1.0.0",
  "comment": "Политика полномочий. Изменять этот файл рабочим ролям запрещено (R-PROT-1). Владелец политики — человек.",
  "product_globs": [
    "src/**",
    "lib/**",
    "app/**",
    "packages/**",
    "tests/**",
    "*.py",
    "*.ts",
    "*.tsx",
    "*.js",
    "*.go",
    "*.rs"
  ],
  "protected_globs": [
    "policies/**",
    "schemas/**",
    ".harness/**",
    "evidence/**",
    "harness/**"
  ],
  "spec_globs": [
    "openspec/**"
  ],
  "privileged_tools": [
    "plugin_manager",
    "plugin_market",
    "plugin_search"
  ],
  "privileged_prefixes": [
    "plugin_",
    "mcp__awgm__",
    "mcp__telegram__",
    "mcp__desktop__"
  ],
  "mcp_allow_globs": [
    "mcp__xerj__*",
    "mcp__trendshift__*"
  ],
  "roles": {
    "human": {
      "description": "Человек-владелец: единственный, кто может менять политику и состояние.",
      "can_read": [
        "**"
      ],
      "can_write": [
        "**"
      ],
      "can_write_product": true,
      "may_dispatch": true,
      "may_commit": true,
      "may_verify": false,
      "tools": [
        "*"
      ]
    },
    "orchestrator": {
      "description": "Координатор: формулирует задачи, запускает исполнителей, собирает вердикты, коммитит. Код не пишет.",
      "can_read": [
        "**"
      ],
      "can_write": [
        "docs/**",
        "pipeline-log/**",
        "briefs/**",
        "briefs",
        "evidence/**"
      ],
      "can_write_product": false,
      "may_dispatch": true,
      "may_commit": true,
      "may_verify": false,
      "tools": [
        "read_file",
        "write_file",
        "dispatch",
        "commit",
        "harness",
        "git_read",
        "bash_readonly",
        "subagent",
        "workflow",
        "list_dir"
      ]
    },
    "briefer": {
      "description": "Готовит самодостаточный пакет задачи. Пишет только брифы.",
      "can_read": [
        "**"
      ],
      "can_write": [
        "briefs/**",
        "briefs"
      ],
      "can_write_product": false,
      "may_dispatch": false,
      "may_commit": false,
      "may_verify": false,
      "tools": [
        "read_file",
        "write_file",
        "harness",
        "list_dir"
      ]
    },
    "analyst": {
      "description": "BA/SA: пишет только продуктовую спеку и документы, не пишет код и не запускает команды.",
      "can_read": [
        "**"
      ],
      "can_write": [
        "openspec/**",
        "docs/**",
        "journal/**",
        "briefs/**"
      ],
      "can_write_product": false,
      "can_write_specs": true,
      "may_dispatch": false,
      "may_commit": false,
      "may_verify": false,
      "tools": [
        "read_file",
        "write_file",
        "harness",
        "mcp__xerj__*",
        "list_dir"
      ]
    },
    "qa": {
      "description": "QA: пишет тесты и кейсы, читает продукт, не меняет код сервисов.",
      "can_read": [
        "**"
      ],
      "can_write": [
        "tests/**",
        "evidence/**",
        "openspec/changes/*/cases/**"
      ],
      "can_write_product": false,
      "product_write_globs": [
        "tests/**"
      ],
      "can_write_specs": true,
      "write_scope_from_brief": true,
      "may_dispatch": false,
      "may_commit": false,
      "may_verify": false,
      "tools": [
        "read_file",
        "write_file",
        "bash",
        "harness",
        "mcp__xerj__*",
        "list_dir"
      ]
    },
    "worker": {
      "description": "Исполнитель. Пишет только в allowed_files из брифа, не трогает git и не диспетчит.",
      "can_read": [
        "**"
      ],
      "can_write": [],
      "write_scope_from_brief": true,
      "can_write_product": true,
      "can_write_services": true,
      "may_dispatch": false,
      "may_commit": false,
      "may_verify": false,
      "tools": [
        "read_file",
        "write_file",
        "bash",
        "harness",
        "subagent",
        "subagent_fork",
        "list_agents",
        "send_message",
        "interrupt_agent",
        "list_dir"
      ]
    },
    "verifier": {
      "description": "Независимый проверяющий. Читает продукт, пишет только вердикт в evidence/.",
      "can_read": [
        "**"
      ],
      "can_write": [
        "evidence/**"
      ],
      "can_write_product": false,
      "may_dispatch": false,
      "may_commit": false,
      "may_verify": true,
      "tools": [
        "read_file",
        "write_file",
        "bash",
        "bash_readonly",
        "harness",
        "list_dir"
      ]
    },
    "adversarial": {
      "description": "Адверсальный проверяющий. Обязан предъявить конкретный сценарий поломки.",
      "can_read": [
        "**"
      ],
      "can_write": [
        "evidence/**"
      ],
      "can_write_product": false,
      "may_dispatch": false,
      "may_commit": false,
      "may_verify": true,
      "tools": [
        "read_file",
        "write_file",
        "bash",
        "harness",
        "list_dir"
      ]
    },
    "system": {
      "description": "Управляющий процесс. Пишет состояние, политики и журналы.",
      "can_read": [
        "**"
      ],
      "can_write": [
        "**"
      ],
      "can_write_product": false,
      "may_dispatch": false,
      "may_commit": false,
      "may_verify": false,
      "tools": [
        "*"
      ]
    }
  },
  "limits": {
    "max_attempts": 3,
    "dispatch_timeout_seconds": 3600
  }
}
